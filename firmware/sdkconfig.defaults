# M1 最小配置（docs/contracts/C06、05-plan M1）：esp32s3 + 16MB flash + 8MB octal PSRAM。
# 无 WiFi/BLE——本工程没有引入会拉起它们的组件。
CONFIG_IDF_TARGET="esp32s3"

# 16 MB Flash（E06 实物核对）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB Octal PSRAM @80 MHz（出厂固件已实测，E07）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 控制台走 USB-Serial-JTAG（与烧录同口 COM7）
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 自定义分区表（C06 冻结表，见 partitions.csv）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 日志 INFO：M1 要靠串口日志确认启动阶段
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 主任务栈 8192（渲染一帧 + 日志留余量）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# CPU 240 MHz
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- M5b-2 BLE GATT 事件通道（C09）：NimBLE peripheral，BLE only（无 Bluedroid/Classic BT）----
# 只追加 BT/NimBLE 行，保留以上全部原有配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y

# 单连接（C09 §1）；ATT 协商 MTU 默认 256 ≥ 247（不依赖单包 ≤512）
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256

# NimBLE host 任务栈：GATT 写回调内同步执行「跨通道去重门 + main 回调（解析/入队）」，
# 默认 4096 偏紧 → 6144（风险说明见 tests/RED-GREEN-M5B2.md）
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# 控制器 BLE 活动实例：广播 + 1 连接 = 2（默认 6，每实例约 828 B RAM）
CONFIG_BT_CTRL_BLE_MAX_ACT=2

# WiFi + BLE 软件共存（WiFi 与 BT 同时启用时 Kconfig 默认 y；显式写出便于审计）
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
